{
  "name": "@better-ccusage/mcp",
  "version": "1.4.3",
  "description": "MCP server implementation for zccusage data with multi-provider support",
  "homepage": "https://github.com/philosophos/zccusage#readme",
  "bugs": {
    "url": "https://github.com/philosophos/zccusage/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/philosophos/zccusage.git"
  },
  "license": "MIT",
  "author": "philosophos",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "zccusage-mcp": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "format": "pnpm run lint --fix",
    "lint": "eslint --cache .",
    "prepack": "pnpm run build && clean-pkg-json",
    "prerelease": "pnpm run lint && pnpm run typecheck && pnpm run build",
    "test": "TZ=UTC vitest run",
    "typecheck": "tsgo --noEmit"
  },
  "devDependencies": {
    "@better-ccusage/internal": "workspace:*",
    "@hono/mcp": "catalog:runtime",
    "@hono/node-server": "catalog:runtime",
    "@modelcontextprotocol/sdk": "catalog:runtime",
    "@ryoppippi/eslint-config": "catalog:lint",
    "@typescript/native-preview": "catalog:types",
    "clean-pkg-json": "catalog:release",
    "eslint": "catalog:lint",
    "fs-fixture": "catalog:testing",
    "gunshi": "catalog:runtime",
    "hono": "catalog:runtime",
    "nano-spawn": "catalog:runtime",
    "tsdown": "catalog:",
    "unplugin-macros": "catalog:build",
    "unplugin-unused": "catalog:build",
    "vitest": "catalog:testing",
    "zccusage": "workspace:*",
    "zod": "catalog:runtime"
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "publishConfig": {
    "bin": {
      "zccusage-mcp": "./dist/index.js"
    },
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    }
  }
}
