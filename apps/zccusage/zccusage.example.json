{
	"$schema": "./config-schema.json",
	"defaults": {
		"mode": "auto",
		"format": "table",
		"statsCurrency": "CNY",
		"costColumns": "billing,stats",
		"rate": "USD/CNY=7.2",
		"dbPath": "~/.cc-switch-tui/zccusage.duckdb",
		"noDuckdb": false,
		"rebuild": false
	},
	"commands": {
		"daily": {
			"breakdown": true,
			"statsCurrency": "CNY"
		},
		"weekly": {
			"format": "tree",
			"treeGroup": "time,project,model"
		},
		"blocks": {
			"live": true,
			"refreshInterval": 5
		}
	}
}
