{
	"$schema": "./apps/zccusage/config-schema.json",
	"defaults": {
		"mode": "auto",
		"format": "tree",
		"group": "agent,reseller,region,plan,model,monthly",
		"statsCurrency": "CNY",
		"costColumns": "billing,stats",
		"rate": "USD/CNY=7.2",
		"dbPath": "~/.config/cc-switch/zccusage.duckdb",
		"noDuckdb": false,
		"rebuild": false,
		"timezone": "Asia/Shanghai",
		"locale": "zh-CN",
		"breakdown": false,
		"order": "desc"
	},
	"commands": {
		"blocks": {
			"refreshInterval": 5,
			"tokenLimit": "500000",
			"sessionLength": 5,
			"active": false
		},
		"statusline": {
			"costSource": "auto",
			"cache": true
		}
	}
}
